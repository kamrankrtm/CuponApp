<?xml version="1.0" encoding="utf-8"?>
<!-- Dubai, bundled so the whole UI renders in one typeface, offline, on every device.
     Replaces the Lato downloadable font, which depended on Play Services. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/dubai_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/dubai_light"
        app:fontStyle="normal"
        app:fontWeight="300" />
    <font
        android:font="@font/dubai_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/dubai_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/dubai_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/dubai_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/dubai_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/dubai_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
