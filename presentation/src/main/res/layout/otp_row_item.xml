<?xml version="1.0" encoding="utf-8"?>
<!-- An older verification code, one row of the "Earlier" group. The adapter picks the group
     background (top, middle, bottom or single) and hides the separator on the last row. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/group_middle"
    android:minHeight="64dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/otpRowIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/rounded_rectangle_8dp"
        android:backgroundTint="?attr/bubbleColor"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_lc_key"
        android:tint="?android:attr/textColorSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/otpRowService"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="?attr/fontMedium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/otpRowMeta"
        app:layout_constraintEnd_toStartOf="@id/otpRowRight"
        app:layout_constraintStart_toEndOf="@id/otpRowIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="بانک ملت (رمز پویا)" />

    <TextView
        android:id="@+id/otpRowMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/otpRowService"
        app:layout_constraintStart_toStartOf="@id/otpRowService"
        app:layout_constraintTop_toBottomOf="@id/otpRowService"
        tools:text="9820000 · Yesterday" />

    <TextView
        android:id="@+id/otpRowCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="?attr/fontMedium"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@id/otpRowState"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="721 855" />

    <TextView
        android:id="@+id/otpRowState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/rounded_rectangle_8dp"
        android:backgroundTint="?attr/bubbleColor"
        android:fontFamily="?attr/fontMedium"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/otpRowCode"
        tools:text="منقضی شده" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/otpRowRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="otpRowCode,otpRowState" />

    <View
        android:id="@+id/otpRowSeparator"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:background="?android:attr/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/otpRowService" />

</androidx.constraintlayout.widget.ConstraintLayout>
