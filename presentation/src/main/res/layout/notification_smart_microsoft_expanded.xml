<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:layoutDirection="rtl" android:padding="13dp"
 android:background="@drawable/experience_notification_microsoft">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
 <View android:layout_width="5dp" android:layout_height="86dp" android:background="#2261CC" />
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:id="@+id/noticeIcon" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp" android:tint="#2261CC" android:contentDescription="نوع اعلان" android:src="@drawable/ic_lc_inbox" />
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/noticeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#244D89" android:textSize="19sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" /><TextView android:id="@+id/noticeBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#244D89" android:textSize="15sp" android:maxLines="4" android:ellipsize="end"  /></LinearLayout></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp"><TextView android:id="@+id/noticeMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#64748B" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"  /></LinearLayout>
 </LinearLayout></LinearLayout>
</LinearLayout>