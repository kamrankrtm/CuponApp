<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetAlarmContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/widgetAlarmShieldIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_lc_shield"
            android:tint="#22C55E" />

        <TextView
            android:id="@+id/widgetAlarmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widgetAlarmShieldIcon"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="دزدگیر اماکن"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetAlarmCredit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:text="اعتبار: ---" />
    </RelativeLayout>

    <!-- Main Status Box -->
    <LinearLayout
        android:id="@+id/widgetAlarmStatusBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_alarm_badge_armed"
        android:orientation="vertical"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/widgetAlarmStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="روشن (فعال)"
                android:textColor="#22C55E"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetAlarmTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="#A1A1AA"
                android:textSize="11sp"
                android:text="۲۰:۰۴" />
        </RelativeLayout>

        <TextView
            android:id="@+id/widgetAlarmDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="از طریق (ریموت ۱)"
            android:textColor="#D1D5DB"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Sensor / Battery Warning (Hidden when empty) -->
    <TextView
        android:id="@+id/widgetAlarmWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_alarm_warning_box"
        android:padding="6dp"
        android:text="⚠️ باتری سنسور شماره ۴ در زون ۴ بی سیم بررسی شود"
        android:textColor="#FBBF24"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widgetBtnArm"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_alarm_btn_arm"
            android:text="روشن (فعال)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widgetBtnDisarm"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_alarm_btn_disarm"
            android:text="خاموش (غیرفعال)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
