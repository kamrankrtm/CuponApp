<?xml version="1.0" encoding="utf-8"?>
<!-- A discount code as a coupon, after Wallet passes: the brand's colour carries the name, the
     deadline and the value; a perforated edge separates the stub with the code and its actions.
     The card clips its children, so the two notch circles show as bites out of the edge. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/cardColor"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Face: tinted with the brand colour at bind time -->
        <LinearLayout
            android:id="@+id/promoHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp"
            tools:background="#E21A5C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/promoBrand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="اسنپ‌فود" />

                        <!-- Shown only when the extractor was unsure the token is really a coupon -->
                        <TextView
                            android:id="@+id/promoUncertain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/rounded_rectangle_8dp"
                            android:backgroundTint="#33FFFFFF"
                            android:fontFamily="?attr/fontMedium"
                            android:includeFontPadding="false"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="نامطمئن"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/promoCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        tools:text="غذا و رستوران" />
                </LinearLayout>

                <!-- Live countdown; turns into a white capsule with red text when time is short -->
                <TextView
                    android:id="@+id/promoExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:drawablePadding="5dp"
                    android:fontFamily="?attr/fontMedium"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    tools:text="۳ ساعت مانده" />
            </LinearLayout>

            <TextView
                android:id="@+id/promoDiscountAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="۷۰ هزار تومان" />

            <TextView
                android:id="@+id/promoDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.86"
                android:maxLines="2"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                tools:text="تخفیف روی سفارش بعدی" />

            <TextView
                android:id="@+id/promoMinOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="#E0FFFFFF"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="حداقل خرید ۲۰۰ هزار تومان"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Perforation: two notches and a dashed tear line straddling the edge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="-11dp"
            android:layout_marginBottom="-11dp">

            <View
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="-11dp"
                android:background="@drawable/circle"
                android:backgroundTint="?attr/groupedBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/dashed_line"
                android:layerType="software" />

            <View
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="-11dp"
                android:background="@drawable/circle"
                android:backgroundTint="?attr/groupedBackground" />
        </FrameLayout>

        <!-- Stub: the code and what to do with it -->
        <LinearLayout
            android:id="@+id/codeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/promoCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textIsSelectable="false"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="FOOD70" />

            <Button
                android:id="@+id/btnOpenApp"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_rectangle_24dp"
                android:backgroundTint="?attr/bubbleColor"
                android:drawablePadding="6dp"
                android:fontFamily="?attr/fontMedium"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="برو"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btnCopyPromo"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/rounded_rectangle_24dp"
                android:drawablePadding="6dp"
                android:fontFamily="?attr/fontMedium"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                tools:backgroundTint="#E21A5C"
                tools:text="کپی کد" />
        </LinearLayout>

        <!-- Quiet secondary actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/btnPinPromo"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="Pin"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnMarkUsed"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:drawablePadding="6dp"
                android:fontFamily="?attr/fontMedium"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="استفاده شد"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnViewOriginal"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:drawablePadding="6dp"
                android:fontFamily="?attr/fontMedium"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="متن پیامک"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
