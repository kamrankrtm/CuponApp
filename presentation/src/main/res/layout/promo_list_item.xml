<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/rounded_rectangle_16dp"
    android:backgroundTint="?attr/bubbleColor"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- Brand avatar: tinted per brand at bind time -->
    <TextView
        android:id="@+id/brandInitial"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/rounded_rectangle_12dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:backgroundTint="#E21A5C"
        tools:text="اس" />

    <ImageView
        android:id="@+id/brandIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/rounded_rectangle_12dp"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_local_offer_black_24dp"
        android:tint="@color/white"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:backgroundTint="#E21A5C" />

    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/promoBrand"
        style="@style/TextPrimary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/promoDiscountAmount"
        app:layout_constraintStart_toEndOf="@id/brandInitial"
        app:layout_constraintTop_toTopOf="@id/brandInitial"
        tools:text="اسنپ‌فود" />

    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/promoDiscountAmount"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_rectangle_24dp"
        android:backgroundTint="?android:attr/colorAccent"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/brandInitial"
        tools:text="۷۰ هزار تومان" />

    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/promoDescription"
        style="@style/TextSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:lines="1"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/promoDiscountAmount"
        app:layout_constraintStart_toEndOf="@id/brandInitial"
        app:layout_constraintTop_toBottomOf="@id/promoBrand"
        tools:text="تخفیف ویژه سفارش غذا" />

    <!-- Shown only when the extractor was unsure the token is really a coupon -->
    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/promoUncertain"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/rounded_rectangle_8dp"
        android:backgroundTint="?android:attr/divider"
        android:paddingStart="8dp"
        android:paddingTop="1dp"
        android:paddingEnd="8dp"
        android:paddingBottom="1dp"
        android:text="نامطمئن"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/brandInitial"
        app:layout_constraintTop_toBottomOf="@id/promoDescription"
        tools:visibility="visible" />

    <!-- Keeps the code box below whichever is taller: the avatar or the text block -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="brandInitial,brandIcon,promoDescription,promoUncertain" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/codeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/promo_code_background"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerBarrier">

        <com.moez.QKSMS.common.widget.QkTextView
            android:id="@+id/promoCode"
            style="@style/TextPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCopyPromo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="FOOD70" />

        <Button
            android:id="@+id/btnOpenApp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/rounded_rectangle_24dp"
            android:backgroundTint="?attr/bubbleColor"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="برو"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCopyPromo"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnCopyPromo"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/rounded_rectangle_24dp"
            android:backgroundTint="@color/tabDiscounts"
            android:minWidth="72dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="کپی کد"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/promoMinOrder"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_rectangle_8dp"
        android:backgroundTint="?android:attr/divider"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/codeContainer"
        tools:text="🛒 حداقل خرید ۲۰۰ هزار تومان"
        tools:visibility="visible" />

    <!-- Live countdown; turns red when the code is nearly dead -->
    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/promoExpiry"
        style="@style/TextSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/btnPinPromo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/promoMinOrder"
        app:layout_goneMarginTop="10dp"
        tools:text="⏰ ۴ ساعت مانده" />

    <Button
        android:id="@+id/btnPinPromo"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:textAllCaps="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="📌"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/promoExpiry"
        app:layout_constraintEnd_toStartOf="@id/btnMarkUsed"
        app:layout_constraintTop_toTopOf="@id/promoExpiry" />

    <Button
        android:id="@+id/btnMarkUsed"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:textAllCaps="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="استفاده شد"
        android:textColor="@color/tabDiscounts"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/promoExpiry"
        app:layout_constraintEnd_toStartOf="@id/btnViewOriginal"
        app:layout_constraintTop_toTopOf="@id/promoExpiry" />

    <Button
        android:id="@+id/btnViewOriginal"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:textAllCaps="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="متن پیامک"
        android:textColor="@color/tabDiscounts"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/promoExpiry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/promoExpiry" />

</androidx.constraintlayout.widget.ConstraintLayout>
