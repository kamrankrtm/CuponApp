<!-- A row modelled on the system Messages list: avatar, name with the time and a chevron on the
     trailing edge, a two-line preview beneath, and a hairline separator inset to the text.
     Unread state is a small accent dot in the leading gutter, so rows never shift sideways. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="72dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/unread"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/circle"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/avatars"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/avatars"
        tools:tint="@color/tools_theme"
        tools:visibility="visible" />

    <com.moez.QKSMS.common.widget.GroupAvatarView
        android:id="@+id/avatars"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0" />

    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/title"
        style="@style/TextPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:fontFamily="?attr/fontMedium"
        android:includeFontPadding="false"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/date"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/avatars"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@tools:sample/full_names" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_lc_chevron_right"
        android:tint="@color/chevron"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title" />

    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/date"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:includeFontPadding="false"
        android:lines="1"
        app:layout_constraintBaseline_toBaselineOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/chevron"
        tools:text="10:24" />

    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/snippet"
        style="@style/TextSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.86"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pinned"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintVertical_bias="0"
        tools:text="@tools:sample/lorem/random" />

    <ImageView
        android:id="@+id/pinned"
        android:layout_width="18dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:paddingStart="4dp"
        android:src="@drawable/ic_lc_pin"
        android:tint="@color/chevron"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/snippet"
        tools:visibility="visible" />

    <View
        android:layout_width="0dp"
        android:layout_height="1px"
        android:background="?android:attr/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/title" />

</androidx.constraintlayout.widget.ConstraintLayout>
