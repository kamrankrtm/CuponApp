<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:layoutDirection="rtl" android:padding="13dp"
 android:background="@drawable/experience_notification_apple">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/noticeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#203148" android:textSize="19sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" /></LinearLayout><ImageView android:id="@+id/noticeIcon" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp" android:tint="#2675C8" android:contentDescription="نوع اعلان" android:src="@drawable/ic_lc_inbox" /></LinearLayout>
 <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:layout_marginBottom="7dp" android:background="#E2E6EC" /><TextView android:id="@+id/noticeBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#203148" android:textSize="15sp" android:maxLines="4" android:ellipsize="end"  />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp"><TextView android:id="@+id/noticeMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#64748B" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"  /></LinearLayout>
</LinearLayout>