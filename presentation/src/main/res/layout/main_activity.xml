<!-- The inbox. A slim top bar with round buttons, then a large title and the category bar
     that scroll together (the title collapses, the categories stay), the list, and a floating
     search + compose bar at the bottom, within reach of the thumb. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Toolbar"
            android:background="@android:color/transparent"
            app:contentInsetStartWithNavigation="0dp">

            <com.moez.QKSMS.common.widget.QkTextView
                android:id="@+id/toolbarTitle"
                style="@style/ToolbarText"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

        </androidx.appcompat.widget.Toolbar>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/mainCoordinator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/mainAppBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:elevation="0dp">

                <com.moez.QKSMS.common.widget.QkTextView
                    android:id="@+id/largeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingStart="20dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    android:text="@string/brand_name"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    app:layout_scrollFlags="scroll|snap" />

                <com.moez.QKSMS.common.widget.CategoryBar
                    android:id="@+id/categoryBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp" />

                <LinearLayout
                    android:id="@+id/discountsFilterBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <!-- Search and AI Scan row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.moez.QKSMS.common.widget.QkEditText
                            android:id="@+id/etPromoSearch"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_rectangle_12dp"
                            android:backgroundTint="?attr/bubbleColor"
                            android:drawableStart="@drawable/ic_lc_search_hint"
                            android:drawablePadding="8dp"
                            android:hint="Search codes or brands"
                            android:includeFontPadding="false"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="12dp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textColorHint="?android:attr/textColorTertiary"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/btnQuickAiScan"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/circle"
                            android:backgroundTint="?attr/bubbleColor"
                            android:contentDescription="AI Scan"
                            android:padding="10dp"
                            android:src="@drawable/ic_lc_sparkles"
                            android:tint="@color/tintDiscounts" />
                    </LinearLayout>

                    <!-- Category chips: filled at runtime from the categories that actually have
                         codes, so the bar can never offer a filter that leads nowhere. -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/promoChipContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Spam tab: says what lives here and how to rescue a sender -->
                <LinearLayout
                    android:id="@+id/spamInfoBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/rounded_rectangle_12dp"
                    android:backgroundTint="?attr/bubbleColor"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lc_bell_off"
                        android:tint="?android:attr/textColorSecondary" />

                    <com.moez.QKSMS.common.widget.QkTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="0.86"
                        android:text="@string/spam_info"
                        android:textColor="?android:attr/textColorSecondary"
                        app:textSize="secondary" />
                </LinearLayout>

            </com.google.android.material.appbar.AppBarLayout>

            <com.moez.QKSMS.common.widget.QkTextView
                android:id="@+id/empty"
                style="@style/TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawablePadding="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="0.9"
                android:paddingStart="48dp"
                android:paddingTop="24dp"
                android:paddingEnd="48dp"
                android:paddingBottom="120dp"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                tools:text="Your conversations will appear here"
                tools:visibility="invisible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="104dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                tools:listitem="@layout/conversation_list_item" />

            <LinearLayout
                android:id="@+id/bottomArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/floatingBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="18dp">

                    <com.moez.QKSMS.common.widget.QkEditText
                        android:id="@+id/toolbarSearch"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/floating_field_background"
                        android:drawableStart="@drawable/ic_lc_search_hint"
                        android:drawablePadding="8dp"
                        android:elevation="6dp"
                        android:hint="@string/title_conversations"
                        android:includeFontPadding="false"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorTertiary"
                        app:textSize="primary" />

                    <ImageView
                        android:id="@+id/compose"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/circle_ripple"
                        android:backgroundTint="@color/tabAll"
                        android:contentDescription="@string/main_fab_cd"
                        android:elevation="6dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_lc_compose"
                        android:tint="@color/white" />
                </LinearLayout>

                <ViewStub
                    android:id="@+id/snackbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:inflatedId="@id/snackbar"
                    android:layout="@layout/main_permission_hint" />

                <ViewStub
                    android:id="@+id/syncing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inflatedId="@id/syncing"
                    android:layout="@layout/main_syncing" />
            </LinearLayout>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>

    <include
        android:id="@+id/drawer"
        layout="@layout/drawer_view"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
