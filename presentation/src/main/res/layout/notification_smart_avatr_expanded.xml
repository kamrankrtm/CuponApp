<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:layoutDirection="rtl" android:padding="13dp"
 android:background="@drawable/experience_notification_avatr">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
 <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="MESSAGE / SYSTEM" android:textColor="#C0A4FF" android:textSize="10sp" android:textStyle="bold" /><ImageView android:id="@+id/noticeIcon" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp" android:tint="#C0A4FF" android:contentDescription="نوع اعلان" android:src="@drawable/ic_lc_inbox" /></LinearLayout>
 <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#C0A4FF" android:layout_marginTop="7dp" android:layout_marginBottom="9dp"/>
 <TextView android:id="@+id/noticeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F3EEFF" android:textSize="19sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp"><TextView android:id="@+id/noticeBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F3EEFF" android:textSize="15sp" android:maxLines="4" android:ellipsize="end"  /></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp"><TextView android:id="@+id/noticeMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D0C3E7" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"  /></LinearLayout>
</LinearLayout>