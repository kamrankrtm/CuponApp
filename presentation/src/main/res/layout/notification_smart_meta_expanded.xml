<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:layoutDirection="rtl" android:padding="13dp"
 android:background="@drawable/experience_notification_meta">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
 <ImageView android:id="@+id/noticeIcon" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp" android:tint="#7563E9" android:contentDescription="نوع اعلان" android:src="@drawable/ic_lc_inbox" /><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ACTIVITY" android:textColor="#7563E9" android:textSize="10sp" android:textStyle="bold" />
 <TextView android:id="@+id/noticeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#3F3376" android:textSize="19sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" /></LinearLayout></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:layout_marginTop="7dp" android:background="#E9DFFF"><TextView android:id="@+id/noticeBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#3F3376" android:textSize="15sp" android:maxLines="4" android:ellipsize="end"  /></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp"><TextView android:id="@+id/noticeMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#72679C" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"  /></LinearLayout>
</LinearLayout>