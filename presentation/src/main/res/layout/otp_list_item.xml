<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/rounded_rectangle_16dp"
    android:backgroundTint="?attr/bubbleColor"
    android:padding="14dp">

    <!-- Key / Shield Icon -->
    <ImageView
        android:id="@+id/otpIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/circle_ripple"
        android:backgroundTint="?android:attr/colorAccent"
        android:padding="10dp"
        android:src="@drawable/ic_smartphone_black_24dp"
        android:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Service / Bank Name -->
    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/otpService"
        style="@style/TextPrimary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/otpDate"
        app:layout_constraintStart_toEndOf="@id/otpIcon"
        app:layout_constraintTop_toTopOf="@id/otpIcon"
        tools:text="بانک ملت (رمز پویا)" />

    <!-- Received Time -->
    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/otpDate"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/otpIcon"
        tools:text="۲ دقیقه پیش" />

    <!-- Subtitle / Hint -->
    <com.moez.QKSMS.common.widget.QkTextView
        android:id="@+id/otpSender"
        style="@style/TextSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/otpDate"
        app:layout_constraintStart_toEndOf="@id/otpIcon"
        app:layout_constraintTop_toBottomOf="@id/otpService"
        tools:text="فرستنده: 200033" />

    <!-- OTP Code Display Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/codeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/rounded_rectangle_8dp"
        android:backgroundTint="?android:attr/divider"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/otpIcon">

        <com.moez.QKSMS.common.widget.QkTextView
            android:id="@+id/otpCode"
            style="@style/TextPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCopyOtp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="849201" />

        <Button
            android:id="@+id/btnCopyOtp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/rounded_rectangle_24dp"
            android:backgroundTint="?android:attr/colorAccent"
            android:minWidth="75dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="کپی مجدد"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
