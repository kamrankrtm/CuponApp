<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/groupedBackground">

    <LinearLayout
        android:id="@+id/preferences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <com.moez.QKSMS.common.widget.QkTextView
            style="@style/SettingsGroupHeader"
            android:text="@string/settings_category_appearance" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/settings_row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_palette"
                app:iconTileColor="@color/tilePink"
                app:chevron="true"
                app:title="@string/settings_theme_title"
                app:widget="@layout/settings_theme_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/night"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_moon"
                app:iconTileColor="@color/tileIndigo"
                app:chevron="true"
                app:valueSummary="true"
                app:title="@string/settings_night_title"
                tools:summary="Automatic" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_moon_star"
                app:iconTileColor="@color/tileGray"
                android:visibility="gone"
                app:title="@string/settings_black_title"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/nightStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_sunset"
                app:iconTileColor="@color/tileIndigo"
                app:chevron="true"
                app:valueSummary="true"
                android:visibility="gone"
                app:title="@string/settings_night_start_title"
                tools:summary="6:00PM" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/nightEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_sunrise"
                app:iconTileColor="@color/tileIndigo"
                app:chevron="true"
                app:valueSummary="true"
                android:visibility="gone"
                app:title="@string/settings_night_end_title"
                tools:summary="9:00AM" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/textSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_type"
                app:iconTileColor="@color/tileBlue"
                app:chevron="true"
                app:valueSummary="true"
                app:title="@string/settings_text_size_title" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/autoColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_user"
                app:iconTileColor="@color/tileOrange"
                app:title="@string/settings_automatic_colors_title"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/systemFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_case"
                app:iconTileColor="@color/tileGray"
                app:title="@string/settings_system_font_title"
                app:widget="@layout/settings_switch_widget" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.moez.QKSMS.common.widget.QkTextView
            style="@style/SettingsGroupHeader"
            android:text="@string/settings_category_general" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/settings_row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_bell"
                app:iconTileColor="@color/tileRed"
                app:chevron="true"
                app:title="@string/settings_notifications_title" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/autoEmoji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_smile"
                app:iconTileColor="@color/tileOrange"
                android:visibility="gone"
                app:title="@string/settings_auto_emoji_title"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/delayed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_timer"
                app:iconTileColor="@color/tileIndigo"
                app:chevron="true"
                app:valueSummary="true"
                app:title="@string/settings_delayed_title"
                tools:summary="No delay" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/swipeActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_swipe"
                app:iconTileColor="@color/tileTeal"
                app:chevron="true"
                android:visibility="visible"
                app:summary="@string/settings_swipe_actions_summary"
                app:title="@string/settings_swipe_actions" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_check_check"
                app:iconTileColor="@color/tileGreen"
                app:summary="@string/settings_delivery_summary"
                app:title="@string/settings_delivery_title"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/signature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_signature"
                app:iconTileColor="@color/tileGray"
                app:chevron="true"
                app:title="@string/settings_signature_title" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/unicode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_languages"
                app:iconTileColor="@color/tileTeal"
                app:summary="@string/settings_unicode_summary"
                app:title="@string/settings_unicode_title"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/mobileOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_smartphone"
                app:iconTileColor="@color/tileGray"
                app:summary="@string/settings_mobile_summary"
                app:title="@string/settings_mobile_title"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/autoDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_trash"
                app:iconTileColor="@color/tileRed"
                app:chevron="true"
                app:valueSummary="true"
                app:title="@string/settings_auto_delete"
                tools:summary="Never" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/longAsMms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_long_mms"
                app:iconTileColor="@color/tileBlue"
                app:summary="@string/settings_long_as_mms_summary"
                app:title="@string/settings_long_as_mms_title"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/mmsSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_image"
                app:iconTileColor="@color/tilePurple"
                app:chevron="true"
                app:valueSummary="true"
                android:visibility="visible"
                app:title="@string/settings_mms_size_title"
                tools:summary="100KB" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/settings_row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_sync"
                app:iconTileColor="@color/tileGreen"
                app:summary="@string/settings_sync_summary"
                app:title="@string/settings_sync_title" />

            <ProgressBar
                android:id="@+id/syncingProgress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:indeterminate="true"
                app:layout_constraintBottom_toBottomOf="parent" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.moez.QKSMS.common.widget.QkTextView
            style="@style/SettingsGroupHeader"
            android:text="Smart Messaging Features" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/settings_row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefDefaultTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_tab"
                app:iconTileColor="@color/tileBlue"
                app:chevron="true"
                app:valueSummary="true"
                app:title="Default Startup Tab"
                app:summary="Personal" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefAutoCopyOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_key"
                app:iconTileColor="@color/tabOtp"
                app:title="Auto-copy OTP verification codes"
                app:summary="Automatically copy one-time passcodes to clipboard"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefSilentSpam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_bell_off"
                app:iconTileColor="@color/tileGray"
                app:title="Mute spam and promotional ads"
                app:summary="Silence notifications for ad messages without discount codes"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefNotifyDiscounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_ticket"
                app:iconTileColor="@color/tabDiscounts"
                app:title="Discount promo notifications"
                app:summary="Show brand name and direct 1-click copy action in notification"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefNotifyPromoExpiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_hourglass"
                app:iconTileColor="@color/tileRed"
                app:title="Discount expiry reminders"
                app:summary="Warn before a valuable code expires, with the SMS text and a copy action"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefJalaliCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_calendar"
                app:iconTileColor="@color/tileGreen"
                app:title="Solar Jalali calendar"
                app:summary="Display dates using Persian Jalali calendar"
                app:widget="@layout/settings_switch_widget" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/SettingsGroupHeader"
            android:text="@string/alarm_guard_settings_group" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/settings_row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

                <com.moez.QKSMS.common.widget.PreferenceView
                    android:id="@+id/prefAlarmGuardEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_lc_shield"
                    app:iconTileColor="@color/tileGreen"
                    app:title="@string/alarm_guard_pref_enable_title"
                    app:summary="@string/alarm_guard_pref_enable_summary"
                    app:widget="@layout/settings_switch_widget" />

                <com.moez.QKSMS.common.widget.PreferenceView
                    android:id="@+id/prefAlarmPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_lc_phone"
                    app:iconTileColor="@color/tileBlue"
                    app:chevron="true"
                    app:valueSummary="true"
                    app:title="@string/alarm_guard_pref_phone_title"
                    app:summary="+989032227190" />

                <com.moez.QKSMS.common.widget.PreferenceView
                    android:id="@+id/prefAlarmArmCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_lc_zap"
                    app:iconTileColor="@color/tileGreen"
                    app:chevron="true"
                    app:valueSummary="true"
                    app:title="@string/alarm_guard_pref_arm_code_title"
                    app:summary="*000000*11#" />

                <com.moez.QKSMS.common.widget.PreferenceView
                    android:id="@+id/prefAlarmDisarmCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_lc_ban"
                    app:iconTileColor="@color/tileRed"
                    app:chevron="true"
                    app:valueSummary="true"
                    app:title="@string/alarm_guard_pref_disarm_code_title"
                    app:summary="*000000*10#" />

                <com.moez.QKSMS.common.widget.PreferenceView
                    android:id="@+id/prefAlarmArmKeywords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_lc_circle_check"
                    app:iconTileColor="@color/tileTeal"
                    app:chevron="true"
                    app:valueSummary="true"
                    app:title="@string/alarm_guard_pref_arm_kw_title"
                    app:summary="فعال شد,فعال گردید,روشن شد" />

                <com.moez.QKSMS.common.widget.PreferenceView
                    android:id="@+id/prefAlarmDisarmKeywords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_lc_message_x"
                    app:iconTileColor="@color/tileOrange"
                    app:chevron="true"
                    app:valueSummary="true"
                    app:title="@string/alarm_guard_pref_disarm_kw_title"
                    app:summary="غیر فعال شد,غیرفعال شد,غیر فعال گردید" />

                <com.moez.QKSMS.common.widget.PreferenceView
                    android:id="@+id/prefAlarmStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_lc_activity"
                    app:iconTileColor="@color/tilePurple"
                    app:chevron="true"
                    app:valueSummary="true"
                    app:title="@string/alarm_guard_pref_status_title"
                    app:summary="@string/alarm_guard_status_unknown" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/SettingsGroupHeader"
            android:text="Cloud Media Sharing (MMS Alternative)" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/settings_row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefMediaAsCloudLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_cloud"
                app:iconTileColor="@color/tileBlue"
                app:title="Upload media to cloud link"
                app:summary="Upload photos and videos to cloud instead of MMS"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefFilesIrToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_token"
                app:iconTileColor="@color/tileGray"
                app:chevron="true"
                app:title="Files.ir API Token"
                app:summary="Optional user API key for direct account uploads" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefFilesIrEndpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_server"
                app:iconTileColor="@color/tileGray"
                app:chevron="true"
                app:title="Files.ir Server Endpoint"
                app:summary="Default: https://my.files.ir" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefZayaApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_link"
                app:iconTileColor="@color/tileTeal"
                app:chevron="true"
                app:title="Zaya.io API Key"
                app:summary="Shorten links before sending SMS" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefTestCloudConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_wifi"
                app:iconTileColor="@color/tileGreen"
                app:title="Test Cloud Connection"
                app:summary="Test connectivity to Files.ir and Zaya.io" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/SettingsGroupHeader"
            android:text="AI Discount Extraction" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/settings_row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefAiApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_sparkles"
                app:iconTileColor="@color/tilePurple"
                app:chevron="true"
                app:title="AI API Key (AvalAI / OpenAI)"
                app:summary="Enter your API key to extract promo codes using AI" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefAiBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_globe"
                app:iconTileColor="@color/tileGray"
                app:chevron="true"
                app:title="AI Service Endpoint"
                app:summary="Default: https://api.avalai.ir/v1" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefAiModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_cpu"
                app:iconTileColor="@color/tileIndigo"
                app:chevron="true"
                app:valueSummary="true"
                app:title="AI Model"
                app:summary="Default: gemini-2.5-flash-lite" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefTestAiConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_activity"
                app:iconTileColor="@color/tileGreen"
                app:title="Test AI Connection"
                app:summary="Verify API key and server connection" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefRunAiScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_search"
                app:iconTileColor="@color/tilePurple"
                app:title="Scan Inbox with AI"
                app:summary="Extract active discount codes from promotional SMS" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefAiAutoSendReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_send"
                app:iconTileColor="@color/tileBlue"
                app:title="Auto-Send AI Replies"
                app:summary="Send generated AI reply immediately without prompt"
                app:widget="@layout/settings_switch_widget" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- AlarmGuard (دزدگیر) Settings Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/settings_row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefAlarmGuardEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_shield"
                app:iconTileColor="@color/tileGreen"
                app:title="دزدگیر اماکن (AlarmGuard)"
                app:summary="فعال‌سازی ویجت و مدیریت هوشمند دزدگیر از پیامک‌ها"
                app:widget="@layout/settings_switch_widget" />

            <com.moez.QKSMS.common.widget.PreferenceView
                android:id="@+id/prefAlarmPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_lc_phone"
