<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background: the brand blue, lighter at the top. The gradient spans the visible
     72dp of the 108dp layer so masks of any shape see the full range. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#0A5CE0"
                android:endX="54"
                android:endY="90"
                android:startColor="#3B93FF"
                android:startX="54"
                android:startY="18"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
