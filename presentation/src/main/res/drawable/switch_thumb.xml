<?xml version="1.0" encoding="utf-8"?>
<!-- The switch knob: a white 27dp disc with a soft shadow, in a 31dp box. The last layer draws
     nothing; its side padding tells SwitchCompat the knob is 20dp wide for layout, so a 51dp
     track gives the knob exactly 2dp of margin at either end, like the system switch. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#0F000000" />
            <size
                android:width="30dp"
                android:height="30dp" />
        </shape>
    </item>
    <item
        android:bottom="0.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="2.5dp">
        <shape android:shape="oval">
            <solid android:color="#1A000000" />
            <size
                android:width="28dp"
                android:height="28dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="0.5dp"
                android:color="#0D000000" />
            <size
                android:width="27dp"
                android:height="27dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size
                android:width="31dp"
                android:height="31dp" />
            <padding
                android:left="5.5dp"
                android:right="5.5dp" />
        </shape>
    </item>
</layer-list>
