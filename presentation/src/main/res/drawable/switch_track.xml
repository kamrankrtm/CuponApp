<?xml version="1.0" encoding="utf-8"?>
<!-- The switch track: a 51x31dp capsule, coloured by QkSwitch's track tint (green when on).
     The empty last layer pads the knob's travel so it stops 2dp inside either end. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15.5dp" />
            <solid android:color="#FFFFFF" />
            <size
                android:width="51dp"
                android:height="31dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <padding
                android:left="5.5dp"
                android:right="5.5dp" />
        </shape>
    </item>
</layer-list>
